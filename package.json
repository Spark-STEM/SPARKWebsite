{
  "name": "spark-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:pages": "wrangler pages dev build --ip 127.0.0.1 --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy:cf": "npm run build && npx wrangler pages deploy build"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.160.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
